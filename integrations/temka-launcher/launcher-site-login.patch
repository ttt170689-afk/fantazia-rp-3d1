+  pending.current=true;const op=++generation.current;setBusy(true);setCode(null);setMessage('');
+  try{const next=await issueFantaziaSiteCode(client);if(op===generation.current&&client.session?.user.id===uid){setClock(Date.now());setCode(next);}}
+  catch(error){if(op===generation.current)setMessage(error instanceof Error?error.message:'Не удалось получить код.');}
+  finally{if(op===generation.current){pending.current=false;setBusy(false);}}
+ }
+ async function copy(){if(!visible)return;const op=generation.current;try{await copyText(visible.code);if(op===generation.current)setMessage('Код скопирован. Никому его не передавай.');}catch{if(op===generation.current)setMessage('Выдели код и скопируй вручную.');}}
+ return <section className="gp-note" aria-label="Код входа на сайт Fantazia">
+  <strong>Код входа на сайт</strong><p>Для одобренных тестеров Fantazia и владельца. Вход в тот же MAIN-аккаунт, без отдельной регистрации.</p>
+  <button className="gp-primary" disabled={busy||mode!=='verified'} onClick={()=>void issue()}>{busy?'Получаем код…':'Получить код входа'}</button>
+  {visible&&<><label>Одноразовый код<input aria-label="Одноразовый код входа Fantazia" readOnly value={visible.code} onFocus={e=>e.currentTarget.select()} style={{display:'block',width:'100%',boxSizing:'border-box',padding:12,fontFamily:'monospace',fontSize:20}}/></label><p>Осталось {Math.max(0,Math.ceil((visible.expiresAt-clock)/1000))} сек. Используется один раз.</p><button onClick={()=>void copy()}>Скопировать код</button></>}
+  {code&&!visible&&mode==='verified'&&<p>Код истёк. Получи новый.</p>}
+  <p><a href={FANTAZIA_LOGIN_URL} target="_blank" rel="noopener noreferrer">Открыть страницу входа Fantazia</a></p>
+  <small>Это не код из письма и не бета-ключ. Код не сохраняется в настройках. Если он уже использован, запроси новый через 30 секунд.</small>
+  {message&&<p role="status">{message}</p>}
+ </section>;
+}
diff --git a/native-bundle/src/lib/fantaziaSiteLogin.ts b/native-bundle/src/lib/fantaziaSiteLogin.ts
new file mode 100644
--- /dev/null
+++ b/native-bundle/src/lib/fantaziaSiteLogin.ts
@@ -0,0 +1,25 @@
+import type {CloudClient} from './online';
+import {onlineFetch} from './onlineTransport';
+export const FANTAZIA_LOGIN_URL = 'https://fantazia-rp-3d1.onrender.com/closed/login';
+const ISSUE_URL = 'https://fantazia-rp-3d1.onrender.com/closed/launcher-code';
+export interface FantaziaSiteCode {code:string; expiresAt:number; accountId:string;}
+export async function requestFantaziaSiteCode(token:string, accountId:string, fetchImpl=onlineFetch):Promise<FantaziaSiteCode> {
+ if(!/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(token)||token.length>5000)throw Error('Войди в основной онлайн-аккаунт.');
+ const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),45000);
+ try {
+  const response=await fetchImpl(ISSUE_URL,{method:'POST',credentials:'omit',redirect:'error',signal:controller.signal,headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:'{}'});
+  const text=await response.text();
+  if(!response.ok)throw Error('Код не выдан. Нужны действующий MAIN-вход и одобрение Fantazia либо роль владельца. Между запросами подожди 30 секунд.');
+  if(text.length>4096)throw Error('Некорректный ответ сервера.');
+  const data=JSON.parse(text),expiresAt=Date.parse(data.expires_at);
+  if(data.ok!==true||typeof data.code!=='string'||!/^FZ-([A-HJ-NP-Z2-9]{4}-){3}[A-HJ-NP-Z2-9]{4}$/.test(data.code)||data.expires_in!==120||!Number.isFinite(expiresAt)||expiresAt<=Date.now()||expiresAt>Date.now()+125000)throw Error('Некорректный код или срок действия. Проверь часы устройства.');
+  return {code:data.code,expiresAt,accountId};
+ } finally { clearTimeout(timer); }
+}
+
+export async function issueFantaziaSiteCode(client:Pick<CloudClient,'session'|'withDevSession'>):Promise<FantaziaSiteCode> {
+ const uid=client.session?.user.id;
+ if(!uid)throw Error('Войди в основной онлайн-аккаунт.');
+ // Existing MAIN token refresh + identity/generation checks. No new auth session.
+ return client.withDevSession(token=>requestFantaziaSiteCode(token,uid));
+}
