+import {useEffect,useRef,useState} from 'react';
+import {useOnlineAccount} from '../lib/onlineAccount';
+import {copyText} from '../lib/clipboard';
+import {FANTAZIA_LOGIN_URL,issueFantaziaSiteCode} from '../lib/fantaziaSiteLogin';
+import type {FantaziaSiteCode} from '../lib/fantaziaSiteLogin';
+
+export default function FantaziaSiteLogin(){
+ const {client,mode}=useOnlineAccount(),uid=client.session?.user.id;
+ const [code,setCode]=useState<FantaziaSiteCode|null>(null),[busy,setBusy]=useState(false),[message,setMessage]=useState(''),[clock,setClock]=useState(Date.now());
+ const generation=useRef(0),pending=useRef(false);
+ useEffect(()=>{generation.current++;pending.current=false;setCode(null);setMessage('');setBusy(false);return()=>{generation.current++;};},[client,uid,mode]);
+ useEffect(()=>{if(!code)return;const timer=setInterval(()=>setClock(Date.now()),1000);return()=>clearInterval(timer);},[code]);
+ const visible=mode==='verified'&&code&&code.accountId===uid&&code.expiresAt>clock?code:null;
+ async function issue(){
+  if(pending.current||mode!=='verified')return;
+  pending.current=true;const op=++generation.current;setBusy(true);setCode(null);setMessage('');
+  try{const next=await issueFantaziaSiteCode(client);if(op===generation.current&&client.session?.user.id===uid){setClock(Date.now());setCode(next);}}
+  catch(error){if(op===generation.current)setMessage(error instanceof Error?error.message:'Не удалось получить код.');}
+  finally{if(op===generation.current){pending.current=false;setBusy(false);}}
+ }
+ async function copy(){if(!visible)return;const op=generation.current;try{await copyText(visible.code);if(op===generation.current)setMessage('Код скопирован. Никому его не передавай.');}catch{if(op===generation.current)setMessage('Выдели код и скопируй вручную.');}}
+ return <section className="gp-note" aria-label="Код входа на сайт Fantazia">
+  <strong>Код входа на сайт</strong><p>Для одобренных тестеров Fantazia и владельца. Вход в тот же MAIN-аккаунт, без отдельной регистрации.</p>
+  <button className="gp-primary" disabled={busy||mode!=='verified'} onClick={()=>void issue()}>{busy?'Получаем код…':'Получить код входа'}</button>
+  {visible&&<><label>Одноразовый код<input aria-label="Одноразовый код входа Fantazia" readOnly value={visible.code} onFocus={e=>e.currentTarget.select()} style={{display:'block',width:'100%',boxSizing:'border-box',padding:12,fontFamily:'monospace',fontSize:20}}/></label><p>Осталось {Math.max(0,Math.ceil((visible.expiresAt-clock)/1000))} сек. Используется один раз.</p><button onClick={()=>void copy()}>Скопировать код</button></>}
+  {code&&!visible&&mode==='verified'&&<p>Код истёк. Получи новый.</p>}
+  <p><a href={FANTAZIA_LOGIN_URL} target="_blank" rel="noopener noreferrer">Открыть страницу входа Fantazia</a></p>
+  <small>Это не код из письма и не бета-ключ. Код не сохраняется в настройках. Если он уже использован, запроси новый через 30 секунд.</small>
+  {message&&<p role="status">{message}</p>}
+ </section>;
+}
