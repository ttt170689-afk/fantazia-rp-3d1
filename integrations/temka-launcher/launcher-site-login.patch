+for(const file of ['fantaziaSiteLogin','online'])buildSync({entryPoints:[path.join(root,'src/lib/'+file+'.ts')],outfile:path.join(dir,file+'.cjs'),bundle:true,platform:'node',format:'cjs',define:{'import.meta.env':'{}'}});
+const {requestFantaziaSiteCode,issueFantaziaSiteCode,FANTAZIA_LOGIN_URL}=require(path.join(dir,'fantaziaSiteLogin.cjs'));
+const {CloudClient}=require(path.join(dir,'online.cjs'));
+const uid='11111111-1111-4111-8111-111111111111',answer=()=>({ok:true,code:'FZ-ABCD-EFGH-JKLM-NPQR',expires_in:120,expires_at:new Date(Date.now()+120000).toISOString()});
+test('code request uses fixed HTTPS endpoint and MAIN bearer only, no cookies or refresh token',async()=>{
+ let calls=0;const result=await requestFantaziaSiteCode('main.fixture.token',uid,async(url,opts)=>{calls++;assert.equal(url,'https://fantazia-rp-3d1.onrender.com/closed/launcher-code');assert.equal(opts.credentials,'omit');assert.equal(opts.redirect,'error');assert.equal(opts.headers.Authorization,'Bearer main.fixture.token');assert.equal(opts.body,'{}');assert(opts.signal);return Response.json(answer());});
+ assert.equal(calls,1);assert.equal(result.accountId,uid);assert.match(result.code,/^FZ-/);assert.equal(FANTAZIA_LOGIN_URL,'https://fantazia-rp-3d1.onrender.com/closed/login');
+});
+test('invalid token, refused approval, email/beta code and expired response fail closed',async()=>{
+ let calls=0;await assert.rejects(requestFantaziaSiteCode('local-user',uid,async()=>{calls++;return Response.json(answer());}));assert.equal(calls,0);
+ await assert.rejects(requestFantaziaSiteCode('main.fixture.token',uid,async()=>Response.json({}, {status:403})));
+ for(const value of [{...answer(),code:'123456'},{...answer(),code:'BETA-KEY'},{...answer(),expires_in:900},{...answer(),expires_at:'bad'},{...answer(),expires_at:new Date(0).toISOString()},{...answer(),expires_at:new Date(Date.now()+3600000).toISOString()}])await assert.rejects(requestFantaziaSiteCode('main.fixture.token',uid,async()=>Response.json(value)));
+});
+test('MAIN account switch/logout during request discards the issued code',async()=>{
+ const oldFetch=global.fetch;
+ try{
+  const client=new CloudClient('fixture',true);client.session={access_token:'main.fixture.token',refresh_token:'never-send',expires_at:Date.now()/1000+3600,user:{id:uid}};
+  global.fetch=async()=>{client.clearTransient();return Response.json(answer());};
+  await assert.rejects(issueFantaziaSiteCode(client),/сессия|аккаунт/i);
+  await assert.rejects(issueFantaziaSiteCode(client),/основной онлайн-аккаунт/);
+ }finally{global.fetch=oldFetch;}
+});
+test('UI clears codes on account changes, expiry is displayed, and no secret/persistent code storage exists',()=>{
+ const ui=fs.readFileSync(path.join(root,'src/components/FantaziaSiteLogin.tsx'),'utf8'),lib=fs.readFileSync(path.join(root,'src/lib/fantaziaSiteLogin.ts'),'utf8');
+ assert(ui.includes('[client,uid,mode]'));assert(ui.includes('code.expiresAt>clock'));assert(ui.includes('client.session?.user.id===uid'));assert(ui.includes('copyText(visible.code)'));
+ assert(!/localStorage|sessionStorage|console\.log|FANTAZIA_RUNTIME_SECRET|sb_secret|service_role/.test(ui+lib));
+ assert(!lib.includes('refresh_token'));
+ const properties=fs.readFileSync(path.join(root,'src/components/GameProperties.tsx'),'utf8');assert(properties.includes('{isPublic&&connected&&<FantaziaSiteLogin/>}'));
+});
