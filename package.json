{
  "name": "fantazia-rp-3d",
  "version": "3.0.0",
  "description": "Fantazia RP 3D multiplayer game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:closed": "node --test tests/closed-*.test.cjs",
    "test:closed:db": "node tests/closed-db-check.cjs",
    "test:launcher-login": "node --test tests/launcher-login*.test.cjs",
    "test:public": "node --test tests/public-*.test.cjs tests/closed-process.test.cjs",
    "test:journal": "node tests/journal47.test.cjs",
    "test:journal:browser": "node tests/journal47.browser.cjs",
    "test:quality:browser": "node tests/quality46.browser.cjs",
    "test:quality": "node tests/quality46.test.cjs && node tests/sound24.test.cjs && node tests/play-policy.test.cjs && node tests/play-integration.test.cjs",
    "test:public:browser": "node tests/public-guest.browser.cjs"
  },
  "dependencies": {
    "express": "^4.22.1",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@sparticuz/chromium": "153.0.0",
    "playwright-core": "1.65.0",
    "socket.io-client": "^4.8.4"
  }
}
