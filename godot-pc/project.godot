; Fantazia RP — separate offline PC migration prototype, not the web release.
config_version=5

[application]
config/name="Fantazia RP — Godot PC 05"
config/version="0.5.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="FantaziaRP-Godot-Prototype"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=60
2d/physics_engine="Dummy"
3d/physics_engine="GodotPhysics3D"

[environment]
defaults/default_clear_color=Color(0.45, 0.61, 0.78, 1)
