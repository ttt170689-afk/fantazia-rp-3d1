{
  "appId": "org.fantazia.rp3d",
  "productName": "Fantazia RP 3D",
  "copyright": "Fantazia RP — создано temka_play_official",
  "directories": {
    "output": "release",
    "buildResources": "desktop/assets"
  },
  "files": [
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/launcher.html",
    "desktop/launcher.css",
    "desktop/launcher.js",
    "desktop/assets/*",
    "url-policy.cjs",
    "package.json"
  ],
  "extraMetadata": {
    "main": "desktop/main.cjs"
  },
  "artifactName": "Fantazia-RP-Portable-${version}-win-${arch}.${ext}",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "desktop/assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Fantazia RP",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "installerLanguages": [
      "ru_RU",
      "en_US"
    ],
    "displayLanguageSelector": true,
    "artifactName": "Fantazia-RP-Setup-${version}-${arch}.${ext}"
  },
  "asar": true,
  "forceCodeSigning": false,
  "extraFiles": [
    {
      "from": "PORTABLE-WINDOWS-RU.txt",
      "to": "README-PORTABLE-RU.txt"
    }
  ]
}
